{
  "name": "dsh-public-relay",
  "version": "0.3.1",
  "description": "把本机 dsh 端口反向代理出去：Host/Origin 改写过信任栅栏、可选强制回环改写（公网也能看到插件列表）、HMAC 口令认证 + 滑动窗口限流、代签 dsh 会话 Cookie（只输中转口令即可进入）、WebSocket 帧级代理与压缩；配合内网穿透可直接访问 dsh 界面。 / Reverse-proxy the local DeepSeek Harness web port out through a tunnel.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./relay": "./lib/relay.js",
    "./auth": "./lib/auth.js",
    "./config": "./lib/config.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale/*.json",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "icon": "./icon.svg",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "relay",
    "proxy",
    "tunnel",
    "frp",
    "reverse-proxy"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liuNNW/dsh-public-relay.git"
  },
  "homepage": "https://github.com/liuNNW/dsh-public-relay",
  "bugs": {
    "url": "https://github.com/liuNNW/dsh-public-relay/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
